{
  "name": "thecocoon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "tsc --noEmit && vite build --config vite.config.ts",
    "build:web": "tsc --noEmit && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts",
    "typecheck": "tsc --noEmit",
    "dev:web": "vite --config vite.config.ts --host 127.0.0.1",
    "play:web": "vite --config vite.config.ts --host 127.0.0.1 --open"
  },
  "dependencies": {
    "@babylonjs/core": "^8.0.0",
    "@babylonjs/havok": "^1.3.14"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  }
}
